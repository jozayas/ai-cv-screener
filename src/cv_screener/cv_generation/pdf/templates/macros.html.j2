{% macro render_headshot(photo_path, full_name, class_name="headshot") -%}
  {% if photo_path %}
    <img class="{{ class_name }}" src="{{ photo_path }}" alt="{{ full_name }} headshot">
  {% endif %}
{%- endmacro %}

{% macro render_section(section) -%}
  <section class="section section-{{ section["kind"] }}">
    <h2>{{ section["title"] }}</h2>
    {% if section["kind"] == "summary" %}
      <p class="summary">{{ section["content"] }}</p>
    {% elif section["kind"] == "skills" %}
      <ul class="tag-list">
        {% for skill in section["items"] %}
          <li>{{ skill }}</li>
        {% endfor %}
      </ul>
    {% elif section["kind"] == "experience" %}
      <div class="timeline">
        {% for item in section["items"] %}
          <article class="entry">
            <header class="entry-header">
              <div>
                <h3>{{ item.role }}</h3>
                <p class="meta">{{ item.company }}</p>
              </div>
              <p class="date-range">
                {{ item.start_date.strftime("%b %Y") }} -
                {{ item.end_date.strftime("%b %Y") if item.end_date else "Present" }}
              </p>
            </header>
            <p>{{ item.summary }}</p>
            {% if item.highlights %}
              <ul>
                {% for highlight in item.highlights %}
                  <li>{{ highlight }}</li>
                {% endfor %}
              </ul>
            {% endif %}
            {% if item.technologies %}
              <p class="technologies">
                <strong>Technologies:</strong> {{ item.technologies | join(", ") }}
              </p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% elif section["kind"] == "education" %}
      <div class="timeline">
        {% for item in section["items"] %}
          <article class="entry">
            <header class="entry-header">
              <div>
                <h3>{{ item.degree }}</h3>
                <p class="meta">{{ item.institution }}</p>
              </div>
              <p class="date-range">{{ item.graduation_year }}</p>
            </header>
            <p>{{ item.field_of_study }}</p>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </section>
{%- endmacro %}
