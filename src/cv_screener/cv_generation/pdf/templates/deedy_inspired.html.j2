{% import "macros.html.j2" as macros %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ profile.full_name }} - CV</title>
    <style>
      @page { size: A4; margin: 0; }
      body {
        color: #1b222a;
        font-family: "Helvetica", "Arial", sans-serif;
        font-size: 9.35pt;
        line-height: 1.34;
        margin: 0;
      }
      h1, h2, h3, p { margin: 0; }
      .page {
        display: grid;
        grid-template-columns: 1fr 64mm;
        min-height: 297mm;
      }
      .main-column {
        padding: 12mm 7mm 12mm 14mm;
      }
      .header {
        border-bottom: 2px solid #1b222a;
        margin-bottom: 0.62rem;
        padding-bottom: 0.48rem;
      }
      .header h1 {
        font-size: 23pt;
        font-weight: 300;
        letter-spacing: 0;
        text-transform: uppercase;
      }
      .identity {
        border-bottom: 0.75px solid #c7d0d9;
        margin-bottom: 0.55rem;
        padding-bottom: 0.45rem;
        text-align: center;
      }
      .headshot {
        border: 1px solid #c7d0d9;
        border-radius: 50%;
        display: block;
        height: 28mm;
        margin: 0 auto 0.55rem;
        object-fit: cover;
        width: 28mm;
      }
      .location { color: #4b5967; font-size: 8.6pt; }
      .contact {
        color: #4b5967;
        font-size: 8.4pt;
        line-height: 1.4;
        margin-top: 0.3rem;
      }
      .layout {
        display: block;
      }
      .section { margin-top: 0.52rem; }
      .section:first-child { margin-top: 0; }
      h2 {
        border-bottom: 0.75px solid #c7d0d9;
        color: #9f1239;
        font-size: 9.4pt;
        letter-spacing: 0.45px;
        margin-bottom: 0.24rem;
        padding-bottom: 0.08rem;
        text-transform: uppercase;
      }
      h3 { font-size: 9.4pt; }
      .entry { margin-bottom: 0.46rem; }
      .entry-header {
        align-items: baseline;
        display: grid;
        gap: 0.5rem;
        grid-template-columns: 1fr auto;
      }
      .meta, .date-range, .summary, .technologies, li { color: #263442; }
      .date-range { font-size: 8.1pt; white-space: nowrap; }
      ul { margin: 0.16rem 0 0 0.8rem; padding: 0; }
      .tag-list { list-style: square; margin-left: 0.8rem; }
      .sidebar {
        background: #f3f5f7;
        box-sizing: border-box;
        min-height: 297mm;
        padding: 12mm 11mm 12mm 7mm;
      }
    </style>
  </head>
  <body>
    <main class="page" data-template-name="{{ template_name }}">
      <section class="main-column">
        <header class="header">
          <h1>{{ profile.full_name }}</h1>
        </header>
        {% for section in main_sections %}
          {{ macros.render_section(section) }}
        {% endfor %}
      </section>
      <aside class="sidebar">
        <header class="identity">
          {{ macros.render_headshot(profile.photo_path, profile.full_name) }}
          <p class="location">{{ profile.location }}</p>
          <p class="contact">{{ profile.email }}<br>{{ profile.phone }}</p>
        </header>
        {% for section in sidebar_sections %}
          {{ macros.render_section(section) }}
        {% endfor %}
      </aside>
    </main>
  </body>
</html>
