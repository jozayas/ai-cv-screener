{% import "macros.html.j2" as macros %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ profile.full_name }} - CV</title>
    <style>
      @page { size: A4; margin: 1.15cm 1.3cm; }
      body {
        color: #18232d;
        font-family: "Helvetica", "Arial", sans-serif;
        font-size: 9.6pt;
        line-height: 1.38;
        margin: 0;
      }
      h1, h2, h3, p { margin: 0; }
      .header {
        border-bottom: 1.5px solid #d3d9df;
        margin-bottom: 0.7rem;
        padding-bottom: 0.58rem;
        text-align: center;
      }
      .identity h1 {
        color: #18232d;
        font-size: 25pt;
        letter-spacing: 0;
        margin-bottom: 0.12rem;
      }
      .identity p { color: #52606d; }
      .contact {
        color: #6b7280;
        font-size: 8.9pt;
        margin-top: 0.28rem;
      }
      .section {
        border-bottom: 0.75px solid #e1e6eb;
        margin-top: 0.56rem;
        padding-bottom: 0.48rem;
      }
      h2 {
        color: #c2410c;
        font-size: 9.6pt;
        letter-spacing: 0.45px;
        margin-bottom: 0.3rem;
        text-transform: uppercase;
      }
      h3 { font-size: 9.75pt; }
      .entry { margin-bottom: 0.48rem; }
      .entry:last-child { margin-bottom: 0; }
      .entry-header {
        align-items: baseline;
        display: grid;
        gap: 0.75rem;
        grid-template-columns: 1fr auto;
      }
      .meta, .date-range, .summary, .technologies, li { color: #2a3845; }
      .date-range { font-size: 8.3pt; white-space: nowrap; }
      ul { margin: 0.2rem 0 0 0.85rem; padding: 0; }
      .tag-list {
        column-gap: 1rem;
        columns: 2;
        list-style: square;
        margin-left: 0.85rem;
      }
    </style>
  </head>
  <body>
    <header class="header" data-template-name="{{ template_name }}">
      <div class="identity">
        <h1>{{ profile.full_name }}</h1>
        <p>{{ profile.location }}</p>
        <p class="contact">{{ profile.email }} | {{ profile.phone }}</p>
      </div>
    </header>
    <main>
      {% for section in main_sections %}
        {{ macros.render_section(section) }}
      {% endfor %}
    </main>
  </body>
</html>
