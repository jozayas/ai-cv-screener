GENERATION__OPENAI_BASE_URL=http://localhost:11434/v1
GENERATION__OPENAI_API_KEY=ollama

# CV content generation
GENERATION__GENERATION_MODEL=gemma3:12b
GENERATION__GENERATION_TEMPERATURE=0.8
GENERATION__GENERATION_MAX_RETRIES=2

# Image generation backend for CV headshots
GENERATION__IMAGE_GENERATION_PROVIDER=openai
GENERATION__IMAGE_GENERATION_MODEL=gpt-image-1
GENERATION__IMAGE_GENERATION_SIZE=1024x1024
GENERATION__IMAGE_GENERATION_MAX_CONCURRENCY=1

# Pollinations image API settings
GENERATION__POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
GENERATION__POLLINATIONS_MODEL=flux

# Hugging Face image API settings
GENERATION__HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/models
GENERATION__HUGGINGFACE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
GENERATION__HUGGINGFACE_API_KEY=

QDRANT__QDRANT_URL=http://localhost:6333
QDRANT__QDRANT_CHECK_COMPATIBILITY=false

LOOKUP__CANDIDATE_NAME_MIN_SCORE=0.72

RAG__OPENAI_BASE_URL=http://localhost:11434/v1
RAG__OPENAI_API_KEY=ollama
RAG__RAG_MODEL=gemma3:12b
RAG__RAG_TEMPERATURE=0
RAG__RAG_MAX_RETRIES=2
RAG__RAG_ENABLE_LLM_REVIEW=false
RAG__RAG_ENABLE_CROSS_ENCODER_RERANK=true
RAG__RAG_MAX_RETRIEVAL_QUERIES=1
