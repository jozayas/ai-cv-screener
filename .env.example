OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# CV content generation
GENERATION_MODEL=gemma3:12b
GENERATION_TEMPERATURE=0.8
GENERATION_MAX_RETRIES=2

# Image generation backend for CV headshots
IMAGE_GENERATION_PROVIDER=openai
IMAGE_GENERATION_MODEL=gpt-image-1
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_MAX_CONCURRENCY=1

# Pollinations image API settings
POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
POLLINATIONS_MODEL=flux

# Hugging Face image API settings
HUGGINGFACE_BASE_URL=https://api-inference.huggingface.co/models
HUGGINGFACE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Set one of these when using the Hugging Face provider.
HUGGINGFACE_API_KEY=
# or
HF_TOKEN=

QDRANT_URL=http://localhost:6333
QDRANT_CHECK_COMPATIBILITY=false

LOOKUP_CANDIDATE_NAME_MIN_SCORE=0.72

RAG_MODEL=gemma3:12b
RAG_TEMPERATURE=0
RAG_MAX_RETRIES=2
